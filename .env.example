# ========================================================
# CAMPUSGIG - Environment Configuration Template
# ========================================================

# Application Ports
PORT=8080
FRONTEND_PORT=5173

# Database Configuration (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/campusgig_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=campusgig_db

# Security & JWT (HMAC-SHA256 Base64 Secret Key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# External AI Configuration (Optional: Gemini API Key for live AI responses)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Frontend API URL (leave empty in local dev for Vite proxy)
VITE_API_URL=http://localhost:8080
